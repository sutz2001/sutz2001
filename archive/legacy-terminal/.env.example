# GitHub Personal Access Token für github-readme-terminal
# Erstelle einen Token unter: https://github.com/settings/tokens
# Benötigte Berechtigungen: public_repo (read-only)
GITHUB_TOKEN=ghp_dein_token_hier

# Optional: ImgBB API Key für Bild-Upload (nicht benötigt für lokale Generierung)
# IMGBB_API_KEY=dein_imgbb_token_hier